{
  "dataset": "SKAB",
  "seed": 42,
  "dtype": "float32",
  "expected_shapes": {
    "train": [12450, 8],
    "test": [5710, 8],
    "label": [5710, 1]
  },
  "preprocessing": {
    "scaler": "StandardScaler",
    "fit_split": "train",
    "train_operation": "fit_transform",
    "test_operation": "transform_only",
    "test_in_fit": false
  },
  "model": {
    "repository": "BaselineModels/TranAD-main",
    "class": "TranAD",
    "window": 10,
    "input_channels": 8,
    "expected_parameters": 7208,
    "input_layout": "batch,window,channels",
    "window_construction": "official_left_pad_previous_points",
    "configuration_status": "fixed external SKAB configuration"
  },
  "training": {
    "epochs": 5,
    "batch_size": 128,
    "optimizer": "Adam",
    "learning_rate": 0.0001,
    "training_test_feature_access": false,
    "training_test_label_access": false
  },
  "evaluation": {
    "anomaly_ratio": 0.5,
    "percentile": 99.5,
    "ratio_source": "results/SKAB_BENCHMARK/protocol.json and results/SKAB_BENCHMARK/three_model_protocol.json",
    "threshold_rule": "percentile(concat(train_score,test_score),99.5)",
    "pot_spot_enabled": false,
    "bf_search_enabled": false,
    "score_search": false,
    "ratio_search": false,
    "threshold_search": false,
    "f1_threshold_search": false,
    "parameter_search": false,
    "test_label_parameter_selection": false
  },
  "audit": {
    "training_label_access": false,
    "test_label_access_during_model_phases": false,
    "test_label_filename": "SKAB_test_label.npy",
    "model_source_modified": false
  }
}
